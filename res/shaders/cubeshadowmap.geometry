#version 330 core

layout (triangles) in;
layout (triangle_strip, max_vertices = 18) out;

out vec3 fragPos;

uniform mat4 viewproj[6];

void main() {
	
	for(int face = 0; face <6; face++) {
		gl_Layer = face;

		for(int i = 0; i<3; i++) {
			fragPos = gl_in[i].gl_Position.xyz;
            gl_Position = viewproj[face] * vec4(fragPos, 1.0);
			EmitVertex();
		}
		EndPrimitive();
	}
}