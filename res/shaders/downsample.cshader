#version 430

// Input texture
uniform sampler2D InputTexture;
// Output image (writeable)
layout(rgba8, binding = 1) uniform image2D OutputImage;

// Thread group size (e.g., [8, 8, 1])
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    // Get output pixel coordinates
    ivec2 outputCoord = ivec2(gl_GlobalInvocationID.xy);

    // Calculate corresponding input region (e.g., for 2x downsampling)
    ivec2 inputBaseCoord = outputCoord * 2;

    // Sample and average 4 pixels
    vec4 sum = 
        texelFetch(InputTexture, inputBaseCoord, 0) +
        texelFetch(InputTexture, inputBaseCoord + ivec2(1, 0), 0) +
        texelFetch(InputTexture, inputBaseCoord + ivec2(0, 1), 0) +
        texelFetch(InputTexture, inputBaseCoord + ivec2(1, 1), 0);

    vec4 downsampledColor = sum / 4.0;

    // Write to output image
    imageStore(OutputImage, outputCoord, downsampledColor);
}